<?php
// Configuration - injected by Ansible
$db_host = "{{ db_endpoint }}";
$db_name = "{{ db_name }}";
$db_user = "{{ db_user }}";
$db_pass = "{{ db_password }}";
$region  = "{{ aws_region }}";
$env     = "{{ environment }}";

// Connect using MySQLi
$conn = mysqli_connect($db_host, $db_user, $db_pass, $db_name);

if ($conn) {
    // Create table if not exists
    mysqli_query($conn, "CREATE TABLE IF NOT EXISTS products (
        id INT AUTO_INCREMENT PRIMARY KEY,
        name VARCHAR(100) NOT NULL,
        price DECIMAL(10,2) NOT NULL,
        stock INT DEFAULT 0,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    )");

    // Insert sample data if empty
    $result = mysqli_query($conn, "SELECT COUNT(*) as count FROM products");
    $row = mysqli_fetch_assoc($result);

    if ($row['count'] == 0) {
        mysqli_query($conn, "INSERT INTO products (name, price, stock) VALUES
            ('Gaming Laptop', 1299.99, 15),
            ('Wireless Mouse', 29.99, 50),
            ('Mechanical Keyboard', 89.99, 30),
            ('4K Monitor', 399.99, 20),
            ('USB-C Hub', 49.99, 45),
            ('Webcam HD', 79.99, 25),
            ('Headphones', 149.99, 35),
            ('External SSD 1TB', 129.99, 40)
        ");
    }

    $result   = mysqli_query($conn, "SELECT * FROM products ORDER BY id");
    $products = mysqli_fetch_all($result, MYSQLI_ASSOC);
    $db_status = "Connected ✓";
} else {
    $db_status = "Error: " . mysqli_connect_error();
    $products  = [];
}

